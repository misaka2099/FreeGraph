  "iniFiles": [
   {
    "path": "/home/hpk/cloud_back_up/whole_system.cfg",
    "content": "[connectivity]\n# Kernel Declarations from all files\nnk=alloc_access_kernel:1:alloc_access_kernel_1\nnk=pma_insert_vertex:2:pma_insert_vertex_1,pma_insert_vertex_2\nnk=pma_insert_edge:2:pma_insert_edge_1,pma_insert_edge_2\nnk=update_message_generator:1:update_message_generator_1\nnk=update_message_router:1:update_message_router_1\nnk=pma_read_kernel:1:pma_read_kernel_1\nnk=signal_kernel:1:signal_kernel_1\nnk=mem_access_kernel:1:mem_access_kernel_1\nnk=edgeReader:1:edgeReader_1\n# Kernel Instance to SLR Assignments\n# SLR0 (Closest to HBM)\nslr=mem_access_kernel_1:SLR0\nslr=alloc_access_kernel_1:SLR0\nslr=update_message_generator_1:SLR0\nslr=pma_read_kernel_1:SLR0\nslr=edgeReader_1:SLR0\n# SLR1 (Middle)\nslr=signal_kernel_1:SLR1\nslr=update_message_router_1:SLR1\nslr=pma_insert_vertex_1:SLR1\nslr=pma_insert_vertex_2:SLR1\n\n# SLR2 (Top)\nslr=pma_insert_edge_1:SLR2\nslr=pma_insert_edge_2:SLR2\n\n# sp=pma_update_kernel_1.hbm_ptr:HBM[0:15]\n# sp=pma_update_kernel_2.hbm_ptr:HBM[0:15]\nsp=mem_access_kernel_1.hbm_ptr_1:HBM[0]\nsp=mem_access_kernel_1.hbm_ptr_2:HBM[1]\nsp=mem_access_kernel_1.pos_pma_addrs:HBM[29]\n\nsp=alloc_access_kernel_1.bm_in_hbm_1:HBM[20]\nsp=alloc_access_kernel_1.bm_in_hbm_2:HBM[21]\n# sp=pma_insert_edge_1.pos_pma_addrs_write:HBM[29]\n# sp=pma_insert_edge_1.neg_pma_addrs_write:HBM[28]\n# sp=pma_insert_edge_2.pos_pma_addrs_write:HBM[29]\n# sp=pma_insert_edge_2.neg_pma_addrs_write:HBM[28]\n\n\nsp=update_message_generator_1.src:HBM[30]\nsp=update_message_generator_1.dst:HBM[31]\n# sp=update_message_generator_1.src_to_change:HBM[27]\n# sp=update_message_generator_1.attr_to_change:HBM[26]\n# sp=pma_update_kernel_1.pos_pma_addrs:HBM[29]\n# sp=pma_update_kernel_1.neg_pma_addrs:HBM[28]\n# sp=pma_update_kernel_2.pos_pma_addrs:HBM[29]\n# sp=pma_update_kernel_2.neg_pma_addrs:HBM[28]\n# Stream Connections from memkernel/connectivity.cfg\n\nstream_connect=pma_insert_vertex_1.req_to_mem_alloc:alloc_access_kernel_1.req_from_vertex_1:16\nstream_connect=alloc_access_kernel_1.vec_info_to_vertex_1:pma_insert_vertex_1.vec_info_back_stream:16\nstream_connect=pma_insert_vertex_2.req_to_mem_alloc:alloc_access_kernel_1.req_from_vertex_2:16\nstream_connect=alloc_access_kernel_1.vec_info_to_vertex_2:pma_insert_vertex_2.vec_info_back_stream:16\n\nstream_connect=pma_insert_edge_1.req_to_mem_alloc:alloc_access_kernel_1.req_from_edge_1:16\nstream_connect=alloc_access_kernel_1.vec_info_to_edge_1:pma_insert_edge_1.vec_info_back_stream:16\nstream_connect=pma_insert_edge_2.req_to_mem_alloc:alloc_access_kernel_1.req_from_edge_2:16\nstream_connect=alloc_access_kernel_1.vec_info_to_edge_2:pma_insert_edge_2.vec_info_back_stream:16\n\n# Mem Access Kernel Connections\nstream_connect=pma_insert_vertex_1.req_to_mem_access:mem_access_kernel_1.req_from_vertex_1:16\nstream_connect=pma_insert_vertex_1.data_to_mem_access:mem_access_kernel_1.data_from_vertex_1:16\nstream_connect=pma_insert_vertex_2.req_to_mem_access:mem_access_kernel_1.req_from_vertex_2:16\nstream_connect=pma_insert_vertex_2.data_to_mem_access:mem_access_kernel_1.data_from_vertex_2:16\n\nstream_connect=pma_insert_edge_1.req_to_mem_access:mem_access_kernel_1.req_from_edge_1:16\nstream_connect=pma_insert_edge_1.data_to_mem_access:mem_access_kernel_1.data_from_edge_1:16\nstream_connect=mem_access_kernel_1.data_to_edge_1:pma_insert_edge_1.data_from_mem_access:16\nstream_connect=mem_access_kernel_1.vec_info_to_edge_1:pma_insert_edge_1.vec_info_from_mem_access:16\nstream_connect=pma_insert_edge_2.req_to_mem_access:mem_access_kernel_1.req_from_edge_2:16\nstream_connect=pma_insert_edge_2.data_to_mem_access:mem_access_kernel_1.data_from_edge_2:16\nstream_connect=mem_access_kernel_1.data_to_edge_2:pma_insert_edge_2.data_from_mem_access:16\nstream_connect=mem_access_kernel_1.vec_info_to_edge_2:pma_insert_edge_2.vec_info_from_mem_access:16\nstream_connect=pma_read_kernel_1.req_to_mem_access_ch1:mem_access_kernel_1.req_from_read_1:16\nstream_connect=pma_read_kernel_1.req_to_mem_access_ch2:mem_access_kernel_1.req_from_read_2:16\nstream_connect=mem_access_kernel_1.data_to_read_1:pma_read_kernel_1.data_from_mem_access_ch1:16\nstream_connect=mem_access_kernel_1.data_to_read_2:pma_read_kernel_1.data_from_mem_access_ch2:16\nstream_connect=mem_access_kernel_1.vec_info_to_read_1:pma_read_kernel_1.vec_info_back_stream_ch1:16\nstream_connect=mem_access_kernel_1.vec_info_to_read_2:pma_read_kernel_1.vec_info_back_stream_ch2:16\nstream_connect=signal_kernel_1.signal_to_mem_access:mem_access_kernel_1.signal_stream:16\n\n# ReGraph edge reader connections\nstream_connect=edgeReader_1.little_cmd_stm:pma_read_kernel_1.cmd_stream:16\n\n\nstream_connect=update_message_router_1.cmd_to_insert_vertex_1:pma_insert_vertex_1.cmd_stream:16\nstream_connect=update_message_router_1.cmd_to_insert_vertex_2:pma_insert_vertex_2.cmd_stream:16\nstream_connect=pma_insert_vertex_1.ack_back_to_router:update_message_router_1.ack_from_insert_vertex_1:16\nstream_connect=pma_insert_vertex_2.ack_back_to_router:update_message_router_1.ack_from_insert_vertex_2:16\n\nstream_connect=update_message_router_1.cmd_to_insert_edge_1:pma_insert_edge_1.cmd_stream:16\nstream_connect=update_message_router_1.cmd_to_insert_edge_2:pma_insert_edge_2.cmd_stream:16\nstream_connect=pma_insert_edge_1.ack_back_to_router:update_message_router_1.ack_from_insert_edge_1:16\nstream_connect=pma_insert_edge_2.ack_back_to_router:update_message_router_1.ack_from_insert_edge_2:16\n\n\nstream_connect=signal_kernel_1.signal_to_alloc_free:alloc_access_kernel_1.signal_stream:16\n# alloc_access_kernel broadcasts control internally; only one signal stream is connected.\n\n\n\n\nstream_connect=update_message_generator_1.cmd_to_router:update_message_router_1.cmd_from_generator:64  \nstream_connect=update_message_router_1.ack_to_generator:update_message_generator_1.ack_from_router:16\n# stream_connect=update_message_router_1.cmd_to_pma_1:pma_update_kernel_1.cmd_stream:16  \n# stream_connect=update_message_router_1.cmd_to_pma_2:pma_update_kernel_2.cmd_stream:16\n# Stream Connections from system_connect.cfg\n\n# REGRAPH_LITTLE_KERNEL_ID_TEXT REGRAPH_LITTLE_KERNEL_ID_TEXT\n# REGRAPH_LITTLE_KERNEL_ID_TEXT REGRAPH_LITTLE_KERNEL_ID_TEXT\n# REGRAPH_LITTLE_KERNEL_ID_TEXT REGRAPH_LITTLE_KERNEL_ID_TEXT\n\n# REGRAPH_BIG_KERNEL_ID_TEXT REGRAPH_BIG_KERNEL_ID_TEXT\n# REGRAPH_BIG_KERNEL_ID_TEXT REGRAPH_BIG_KERNEL_ID_TEXT\n# REGRAPH_BIG_KERNEL_ID_TEXT REGRAPH_BIG_KERNEL_ID_TEXT\n\n# REGRAPH_ALL_KERNEL_ID_TEXT REGRAPH_APPLY_KERNEL_HBM_ID\n\n# REGRAPH_LITTLE_KERNEL_NUM\n# REGRAPH_LITTLE_KERNEL_ID_TEXT REGRAPH_LITTLE_KERNEL_HBM_ID\n# REGRAPH_LITTLE_KERNEL_ID_TEXT REGRAPH_LITTLE_KERNEL_SLR_ID\n\n# REGRAPH_BIG_KERNEL_NUM\n# REGRAPH_BIG_KERNEL_ID_TEXT REGRAPH_BIG_KERNEL_HBM_ID\n# REGRAPH_BIG_KERNEL_ID_TEXT REGRAPH_BIG_KERNEL_SLR_ID\n\n\n# --------------------------------------------------------------------------------------------------------------------#\n#                          Little Gather Scatter Merger Kernel \u003c=\u003e Little Scatter Gather Kernel                       #\n# --------------------------------------------------------------------------------------------------------------------#\n\nstream_connect=edgeReader_1.little_edge_burst_stm:littleKernelScatterGather_1.part_edge_burst_stm:16\nstream_connect=edgeReader_1.little_edge_num_stm:littleKernelScatterGather_1.part_edge_num_stm:16\n\nstream_connect=littleKernelScatterGather_1.l_ppb_request_stm:kernelHBMWrapper_1.l_ppb_request_stm_1 \n\nstream_connect=kernelHBMWrapper_1.l_ppb_response_stm_1:littleKernelScatterGather_1.l_ppb_response_stm \n\nstream_connect=littleKernelScatterGather_1.l_tmp_prop_stm:kernelLittleGSMerger_1.l_tmp_prop_stm_1:16\n\n# --------------------------------------------------------------------------------------------------------------------#\n#                            Big Gather Scatter Merger Kernel \u003c=\u003e Big Scatter Gather Kernel                           #\n# --------------------------------------------------------------------------------------------------------------------#\n\nstream_connect=edgeReader_1.big_edge_burst_stm:bigKernelScatterGather_1.part_edge_burst_stm:16\nstream_connect=edgeReader_1.big_edge_num_stm:bigKernelScatterGather_1.part_edge_num_stm:16\n\nstream_connect=bigKernelScatterGather_1.b_cacheline_request_stm:kernelHBMWrapper_1.b_cacheline_request_stm_1:16\n\nstream_connect=kernelHBMWrapper_1.b_cacheline_response_stm_1:bigKernelScatterGather_1.b_cacheline_response_stm:16\n\nstream_connect=bigKernelScatterGather_1.b_tmp_prop_stm:kernelBigGSMerger_1.b_tmp_prop_stm_1 \n\n# ---------------------------------------------------------------------------------------------------#\n#               Little / Big Gather Scatter Merger Kernel \u003c=\u003e Merge Apply Write Kernel               #\n# ---------------------------------------------------------------------------------------------------#\n\nstream_connect=kernelLittleGSMerger_1.l_write_burst_stm:kernelApply_1.l_merged_prop_stm:16\nstream_connect=kernelBigGSMerger_1.b_write_burst_stm:kernelApply_1.b_merged_prop_stm:16\n\n# ---------------------------------------------------------------------------------------------------#\n#                                     Apply Kernel \u003c=\u003e HBM Wrapper                                   #\n# ---------------------------------------------------------------------------------------------------#\n\nstream_connect=kernelApply_1.prop_write_burst_stm:kernelHBMWrapper_1.prop_write_burst_stm:16\n\n# -----------------------------------------------------#\n#                     Merger  Kernels                  #\n# -----------------------------------------------------#\n\nnk=kernelLittleGSMerger:1\nslr=kernelLittleGSMerger_1:SLR1\n\nnk=kernelBigGSMerger:1\nslr=kernelBigGSMerger_1:SLR1\n\n# -----------------------------------------------------#\n#                     Edge Reader                      #\n# -----------------------------------------------------#\n\n# nk=edgeReader:1\n# slr=edgeReader_1:SLR0\nstream_connect=pma_read_kernel_1.data_to_coo_stream:edgeReader_1.coo_array_stm:16\nstream_connect=pma_read_kernel_1.coo_edge_count_stream:edgeReader_1.little_coo_edge_num_stm:16\n\n# -----------------------------------------------------#\n#                      Apply  Kernel                   #\n# -----------------------------------------------------#\n\nnk=kernelApply:1\n\n\n\nslr=kernelApply_1:SLR1\n\n\n# -----------------------------------------------------#\n#                       HBM Wrapper                    #\n# -----------------------------------------------------#\n\nnk=kernelHBMWrapper:1\n\nsp=kernelHBMWrapper_1.src_prop_1:HBM[1]\nsp=kernelHBMWrapper_1.src_prop_2:HBM[3]\n\nsp=kernelHBMWrapper_1.new_prop_1:HBM[1]\nsp=kernelHBMWrapper_1.new_prop_2:HBM[3]\n\nslr=kernelHBMWrapper_1:SLR0\n\n\n# -----------------------------------------------------#\n#             Little Scatter Gather Kernel             #\n# -----------------------------------------------------#\n\nnk=littleKernelScatterGather:1\n\nslr=littleKernelScatterGather_1:SLR0\n\n\n# -----------------------------------------------------#\n#              Big Scatter Gather Kernel               #\n# -----------------------------------------------------#\n\nnk=bigKernelScatterGather:1\n\nslr=bigKernelScatterGather_1:SLR1\n\n[vivado]\nprop=fileset.sim_1.xsim.elaborate.debug_level=all"
   },
